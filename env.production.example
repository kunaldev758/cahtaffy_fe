# Copy to .env on EC2 before npm run build (subdomain deploy)

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_MARKETING_URL=https://chataffy.com/
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.chataffy.com/
NEXT_PUBLIC_AGENT_URL=https://agent.chataffy.com/
NEXT_PUBLIC_APP_URL=https://dashboard.chataffy.com/

API_HOST=https://chataffy.com/api/
NEXT_PUBLIC_API_HOST=https://chataffy.com
NEXT_PUBLIC_SOCKET_HOST=https://chataffy.com/
NEXT_PUBLIC_FILE_HOST=https://chataffy.com
NEXT_PUBLIC_BASE_URL=https://chataffy.com
NEXT_PUBLIC_SOCKET_PATH=
# Must be empty (no spaces after =) — legacy /chataffy/cahtaffy_fe base path removed
NEXT_PUBLIC_BASE_PATH=

# Add your real keys on EC2 (required if you use these features):
NEXT_PUBLIC_BIGCOMMERCE_CLIENT_ID=
IPINFO_URL=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_SHOPIFY_API_KEY=

# Backend .env (not Next.js): AUTH_COOKIE_DOMAIN=.chataffy.com
